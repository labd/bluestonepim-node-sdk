{
	"name": "@labdigital/bluestonepim-sdk",
	"version": "0.1.0",
	"description": "Bluestone PIM SDK",
	"keywords": [
		"sdk",
		"bluestone",
		"bluestonepim",
		"pim"
	],
	"license": "MIT",
	"author": "Lab Digital <opensource@labdigital.nl>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/labd/bluestonepim-node-sdk.git"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"sideEffects": false,
	"scripts": {
		"build": "tsdown",
		"check": "biome ci && pnpm typecheck",
		"format": "biome format",
		"format:fix": "biome format --write",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"lint:knip": "knip",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"sdk:generate": "openapi-generator-cli generate -i https://docs.api.bluestonepim.com/openapi/665580c80a124b001f16a96c -g typescript-fetch -o src/ --additional-properties=prefixParameterInterfaces=true && pnpm lint:fix",
		"publish:ci": "pnpm build && pnpm changeset publish",
		"publish:version": "pnpm changeset version && pnpm format:fix",
		"lint:package": "publint --strict"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@changesets/cli": "^3.0.3",
		"@openapitools/openapi-generator-cli": "2.41.0",
		"@types/node": "^26.6.5",
		"@vitest/coverage-v8": "^5.0.5",
		"knip": "^6.42.0",
		"publint": "^0.3.25",
		"tsdown": "^0.23.1",
		"typescript": "^7.0.2",
		"vitest": "5.0.5"
	},
	"packageManager": "pnpm@12.14.0",
	"engines": {
		"node": ">=22",
		"pnpm": ">=12"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"files": [
		"dist",
		"src"
	]
}
